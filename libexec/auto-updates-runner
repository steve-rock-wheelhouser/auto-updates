#!/bin/bash
# ==============================================================================
# auto-updates-runner
# Systemd service runner script for automated package updates.
# Supports Fedora, Rocky Linux, AlmaLinux, RHEL, and CentOS Stream.
#
# Copyright (C) 2026 Steve Rock <steve.rock@wheelhouser.com>
#
# This program is free software: you can redistribute it and/or modify
# it under the terms of the GNU General Public License as published by
# the Free Software Foundation, either version 3 of the License, or
# (at your option) any later version.
# ==============================================================================

set -euo pipefail

# Ensure standard system tools are in PATH
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:${PATH:-}"

CONF_FILE="/etc/auto-updates/auto-updates.conf"
DNF_AUTO_CONF="/etc/dnf/automatic.conf"

# Default configuration values
MODE="security"
SCHEDULE_TIME="03:30"
WEEKLY_DAY="Sun"
RANDOM_SLEEP="10"
REBOOT="never"
REBOOT_DELAY="0"
EMIT_VIA="stdio"
LOG_FILE="/var/log/auto-updates/auto-updates.log"
REFRESH_METADATA="true"
DEFER_REBOOT_IF_BUSY="true"
INCLUDE_PHASED_UPDATES="false"

# Load system configuration if present
if [ -f "$CONF_FILE" ]; then
    # shellcheck source=/dev/null
    source "$CONF_FILE"
fi

INCLUDE_PHASED_UPDATES="${INCLUDE_PHASED_UPDATES:-false}"

# Determine if log file is writable
CAN_WRITE_LOG=false
if [ -w "$LOG_FILE" ] 2>/dev/null || { [ ! -e "$LOG_FILE" ] && [ -w "$(dirname "$LOG_FILE" 2>/dev/null)" ]; } 2>/dev/null; then
    CAN_WRITE_LOG=true
    mkdir -p "$(dirname "$LOG_FILE")" 2>/dev/null || true
    touch "$LOG_FILE" 2>/dev/null || true
fi

log() {
    local level="$1"
    shift
    local msg="[$(date '+%Y-%m-%d %H:%M:%S')] [$level] $*"
    echo "$msg"
    if [ "$CAN_WRITE_LOG" = true ]; then
        echo "$msg" >> "$LOG_FILE" 2>/dev/null || true
    fi
}

emit_log() {
    if [ "$CAN_WRITE_LOG" = true ]; then
        tee -a "$LOG_FILE"
    else
        cat
    fi
}

# Parse runner flags
OVERRIDE_TYPE=""
DRY_RUN=false
SKIP_SLEEP=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        --force-security)
            OVERRIDE_TYPE="security"
            SKIP_SLEEP=true
            shift
            ;;
        --force-all)
            OVERRIDE_TYPE="default"
            SKIP_SLEEP=true
            shift
            ;;
        --dry-run)
            DRY_RUN=true
            SKIP_SLEEP=true
            shift
            ;;
        --no-sleep)
            SKIP_SLEEP=true
            shift
            ;;
        --refresh)
            REFRESH_METADATA=true
            shift
            ;;
        --no-refresh)
            REFRESH_METADATA=false
            shift
            ;;
        --defer-reboot)
            DEFER_REBOOT_IF_BUSY=true
            shift
            ;;
        --no-defer-reboot)
            DEFER_REBOOT_IF_BUSY=false
            shift
            ;;
        --include-phased)
            INCLUDE_PHASED_UPDATES=true
            shift
            ;;
        --no-include-phased)
            INCLUDE_PHASED_UPDATES=false
            shift
            ;;
        *)
            shift
            ;;
    esac
done

# Determine update type (security vs default/all)
CURRENT_DAY="$(date +%a)"
if [ -n "$OVERRIDE_TYPE" ]; then
    UPGRADE_TYPE="$OVERRIDE_TYPE"
    REASON="Manually forced $UPGRADE_TYPE update"
elif [ "$MODE" = "all" ] || [ "$MODE" = "daily-all" ]; then
    UPGRADE_TYPE="default"
    REASON="Daily full update (all packages)"
elif [ "$MODE" = "weekly-all" ] || [ "$MODE" = "all-weekly" ]; then
    if [ "$CURRENT_DAY" = "$WEEKLY_DAY" ]; then
        UPGRADE_TYPE="default"
        REASON="Weekly full update ($CURRENT_DAY matched WEEKLY_DAY)"
    else
        UPGRADE_TYPE="security"
        REASON="Daily security update (weekly full update scheduled on $WEEKLY_DAY)"
    fi
else
    UPGRADE_TYPE="security"
    REASON="Daily security update"
fi

# Optional random delay to avoid thundering herd problem
if [ "$SKIP_SLEEP" = false ] && [ "$RANDOM_SLEEP" -gt 0 ]; then
    JITTER=$(( RANDOM % RANDOM_SLEEP ))
    log "INFO" "Applying random delay of ${JITTER}s (max: ${RANDOM_SLEEP}s)..."
    sleep "$JITTER"
fi

log "INFO" "Starting Auto-Updates run. Target: $UPGRADE_TYPE ($REASON)"

# Helper function to set key = value in INI file
set_ini_val() {
    local file="$1"
    local key="$2"
    local val="$3"
    local section="${4:-commands}"

    if [ ! -f "$file" ]; then
        mkdir -p "$(dirname "$file")"
        cat <<EOF > "$file"
[$section]
$key = $val
EOF
        return 0
    fi

    if grep -q -E "^[#[:space:]]*${key}[[:space:]]*=" "$file"; then
        sed -i -E "s|^[#[:space:]]*${key}[[:space:]]*=.*|${key} = ${val}|" "$file"
    else
        if grep -q -E "^\[${section}\]" "$file"; then
            sed -i -E "/^\[${section}\]/a ${key} = ${val}" "$file"
        else
            echo "" >> "$file"
            echo "[$section]" >> "$file"
            echo "${key} = ${val}" >> "$file"
        fi
    fi
}

detect_backend() {
    if [ -f /etc/os-release ]; then
        local os_id=""
        os_id=$(grep -E '^(ID|ID_LIKE)=' /etc/os-release 2>/dev/null || true)
        case "$os_id" in
            *debian*|*ubuntu*)
                echo "apt"
                return 0
                ;;
        esac
    fi

    if command -v dnf5 &>/dev/null && dnf5 automatic --help &>/dev/null; then
        echo "dnf5"
    elif command -v dnf-automatic &>/dev/null; then
        echo "dnf4"
    elif command -v dnf &>/dev/null; then
        echo "dnf"
    elif command -v apt-get &>/dev/null; then
        echo "apt"
    else
        echo "unknown"
    fi
}

BACKEND=$(detect_backend)

# Update /etc/dnf/automatic.conf on RPM systems (only on active update runs)
if [ "$BACKEND" != "apt" ] && [ "$DRY_RUN" = false ]; then
    set_ini_val "$DNF_AUTO_CONF" "apply_updates" "yes" "commands"
    set_ini_val "$DNF_AUTO_CONF" "download_updates" "yes" "commands"
    set_ini_val "$DNF_AUTO_CONF" "upgrade_type" "$UPGRADE_TYPE" "commands"
    set_ini_val "$DNF_AUTO_CONF" "random_sleep" "0" "commands"
    set_ini_val "$DNF_AUTO_CONF" "emit_via" "$EMIT_VIA" "emitters"
fi

# Execute update transaction
EXEC_START=$(date +%s)
STATUS=0

# Capture package state before transaction to detect whether packages actually changed
PKG_STATE_BEFORE=""
if command -v rpm &>/dev/null; then
    PKG_STATE_BEFORE=$(rpm -qa --last 2>/dev/null | head -n 1 || true)
elif [ -f /var/log/dpkg.log ]; then
    PKG_STATE_BEFORE=$(tail -n 1 /var/log/dpkg.log 2>/dev/null || true)
fi

REFRESH_OPT=""
if [ "$REFRESH_METADATA" = "true" ]; then
    REFRESH_OPT="--refresh"
fi

TX_OUTPUT_FILE=$(mktemp /tmp/auto-updates-tx.XXXXXX 2>/dev/null || mktemp)
# shellcheck disable=SC2064
trap "rm -f '$TX_OUTPUT_FILE' 2>/dev/null || true" EXIT

run_with_capture() {
    local rc=0
    "$@" 2>&1 | tee -a "$TX_OUTPUT_FILE" | emit_log || rc=${PIPESTATUS[0]}
    return "$rc"
}

if [ "$BACKEND" = "apt" ]; then
    log "INFO" "Using backend: APT / Unattended-Upgrades (refresh: ${REFRESH_METADATA}, include phased: ${INCLUDE_PHASED_UPDATES})"
    if [ "$REFRESH_METADATA" = "true" ]; then
        log "INFO" "Refreshing APT package indices (apt-get update)..."
        run_with_capture apt-get update -qq || true
    fi

    APT_PHASED_ARGS=()
    if [ "${INCLUDE_PHASED_UPDATES:-false}" = "true" ]; then
        APT_PHASED_ARGS+=("-o" "APT::Get::Always-Include-Phased-Updates=true")
    fi

    if [ "$UPGRADE_TYPE" = "security" ]; then
        if command -v unattended-upgrade &>/dev/null; then
            if [ "$DRY_RUN" = true ]; then
                log "INFO" "Simulating security updates via unattended-upgrade --dry-run..."
                run_with_capture unattended-upgrade --dry-run || STATUS=$?
            else
                log "INFO" "Applying security updates via unattended-upgrade..."
                run_with_capture unattended-upgrade -d || STATUS=$?
            fi
        else
            log "WARN" "unattended-upgrade command not found; using apt-get --only-upgrade..."
            if [ "$DRY_RUN" = true ]; then
                run_with_capture apt-get -s --only-upgrade upgrade -y "${APT_PHASED_ARGS[@]}" || STATUS=$?
            else
                DEBIAN_FRONTEND=noninteractive run_with_capture apt-get --only-upgrade upgrade -y -q \
                    -o Dpkg::Options::="--force-confdef" -o Dpkg::Options::="--force-confold" "${APT_PHASED_ARGS[@]}" || STATUS=$?
            fi
        fi
    else
        # Full upgrade (all packages)
        if [ "$DRY_RUN" = true ]; then
            log "INFO" "Simulating full system upgrade via apt-get -s dist-upgrade..."
            run_with_capture apt-get -s dist-upgrade "${APT_PHASED_ARGS[@]}" || STATUS=$?
        else
            log "INFO" "Applying full system upgrade via apt-get dist-upgrade..."
            DEBIAN_FRONTEND=noninteractive run_with_capture apt-get dist-upgrade -y -q \
                -o Dpkg::Options::="--force-confdef" -o Dpkg::Options::="--force-confold" "${APT_PHASED_ARGS[@]}" || STATUS=$?
        fi
    fi
elif [ "$BACKEND" = "dnf5" ]; then
    log "INFO" "Using backend: DNF5 automatic (refresh: ${REFRESH_METADATA})"
    if [ "$DRY_RUN" = true ]; then
        if [ "$UPGRADE_TYPE" = "security" ]; then
            log "INFO" "Checking available security updates via dnf5 check-upgrade --security..."
            # shellcheck disable=SC2086
            run_with_capture dnf5 $REFRESH_OPT check-upgrade --security || STATUS=$?
        else
            log "INFO" "Checking all available updates via dnf5 check-upgrade..."
            # shellcheck disable=SC2086
            run_with_capture dnf5 $REFRESH_OPT check-upgrade || STATUS=$?
        fi
    else
        # shellcheck disable=SC2086
        run_with_capture dnf5 $REFRESH_OPT automatic --installupdates || STATUS=$?
    fi
elif [ "$BACKEND" = "dnf4" ]; then
    log "INFO" "Using backend: DNF4 dnf-automatic (refresh: ${REFRESH_METADATA})"
    if [ "$REFRESH_METADATA" = "true" ]; then
        log "INFO" "Refreshing DNF4 repository metadata cache..."
        run_with_capture dnf makecache --refresh || true
    fi
    if [ "$DRY_RUN" = true ]; then
        if [ "$UPGRADE_TYPE" = "security" ]; then
            log "INFO" "Checking available security updates via dnf check-upgrade --security..."
            # shellcheck disable=SC2086
            run_with_capture dnf $REFRESH_OPT check-upgrade --security || STATUS=$?
        else
            log "INFO" "Checking all available updates via dnf check-upgrade..."
            # shellcheck disable=SC2086
            run_with_capture dnf $REFRESH_OPT check-upgrade || STATUS=$?
        fi
    else
        run_with_capture dnf-automatic "$DNF_AUTO_CONF" --installupdates || STATUS=$?
    fi
else
    # Fallback to direct dnf invocation
    log "WARN" "dnf-automatic command not found; falling back to direct dnf invocation"
    if [ "$UPGRADE_TYPE" = "security" ]; then
        if [ "$DRY_RUN" = true ]; then
            # shellcheck disable=SC2086
            run_with_capture dnf $REFRESH_OPT check-upgrade --security || STATUS=$?
        else
            # shellcheck disable=SC2086
            run_with_capture dnf $REFRESH_OPT upgrade -y --security || STATUS=$?
        fi
    else
        if [ "$DRY_RUN" = true ]; then
            # shellcheck disable=SC2086
            run_with_capture dnf $REFRESH_OPT check-upgrade || STATUS=$?
        else
            # shellcheck disable=SC2086
            run_with_capture dnf $REFRESH_OPT upgrade -y || STATUS=$?
        fi
    fi
fi

EXEC_END=$(date +%s)
DURATION=$(( EXEC_END - EXEC_START ))

# Inspect transaction output for warnings, held packages, and conflicts
HAS_TRANSACTION_WARNINGS=false

if [ "$BACKEND" = "apt" ]; then
    if grep -qi "deferred due to phasing" "$TX_OUTPUT_FILE" 2>/dev/null; then
        HAS_TRANSACTION_WARNINGS=true
        phased_list=$(awk '/deferred due to phasing:/{flag=1; next} /^[0-9]+ upgraded/{flag=0} flag' "$TX_OUTPUT_FILE" 2>/dev/null | tr -s '[:space:]' ' ' | sed 's/^[ ]*//;s/[ ]*$//' || true)
        if [ -n "$phased_list" ]; then
            log "WARN" "Ubuntu phased updates deferred: $phased_list"
        else
            log "WARN" "Ubuntu phased updates were deferred by APT policy."
        fi
        if [ "${INCLUDE_PHASED_UPDATES:-false}" != "true" ]; then
            log "INFO" "To apply phased updates immediately, enable INCLUDE_PHASED_UPDATES=true (sudo auto-updates set-phased-updates true)."
        fi
    fi

    if grep -qi "The following packages have been kept back:" "$TX_OUTPUT_FILE" 2>/dev/null; then
        HAS_TRANSACTION_WARNINGS=true
        kept_list=$(awk '/The following packages have been kept back:/{flag=1; next} /^[0-9]+ upgraded/{flag=0} flag' "$TX_OUTPUT_FILE" 2>/dev/null | tr -s '[:space:]' ' ' | sed 's/^[ ]*//;s/[ ]*$//' || true)
        if [ -n "$kept_list" ]; then
            log "WARN" "Packages kept back by APT due to dependency pinning or deprecation: $kept_list"
        else
            log "WARN" "Some packages were kept back by APT."
        fi
    fi

    if grep -q -E "[0-9]+ not upgraded" "$TX_OUTPUT_FILE" 2>/dev/null; then
        not_upgraded=$(grep -oE "[0-9]+ not upgraded" "$TX_OUTPUT_FILE" 2>/dev/null | head -n 1 || true)
        if [ "$not_upgraded" != "0 not upgraded" ] && [ "$HAS_TRANSACTION_WARNINGS" = false ]; then
            HAS_TRANSACTION_WARNINGS=true
            log "WARN" "APT completed with $not_upgraded."
        fi
    fi
else
    # DNF4 / DNF5
    if grep -qi -E "(Skipping packages with conflicts|Skipping packages with broken dependencies)" "$TX_OUTPUT_FILE" 2>/dev/null; then
        HAS_TRANSACTION_WARNINGS=true
        skipped_summary=$(grep -E "Skipping packages with (conflicts|broken dependencies):" -A 3 "$TX_OUTPUT_FILE" 2>/dev/null | grep -E '^[[:space:]]+[a-zA-Z0-9_-]+' | tr -s '[:space:]' ' ' | sed 's/^[ ]*//;s/[ ]*$//' | head -n 5 || true)
        if [ -n "$skipped_summary" ]; then
            log "WARN" "DNF skipped packages due to conflicts or broken dependencies: $skipped_summary"
        else
            log "WARN" "DNF skipped packages due to conflicts or broken dependencies."
        fi
    fi

    if grep -qi -E "^Problem [0-9]+:" "$TX_OUTPUT_FILE" 2>/dev/null; then
        HAS_TRANSACTION_WARNINGS=true
        prob_count=$(grep -c -E "^Problem [0-9]+:" "$TX_OUTPUT_FILE" 2>/dev/null || true)
        log "WARN" "DNF reported $prob_count transaction dependency problem(s)."
    fi
fi

# Check result (exit codes 0 and 100 for check-update mean success)
if [ "$STATUS" -eq 0 ] || [ "$STATUS" -eq 100 ]; then
    if [ "$HAS_TRANSACTION_WARNINGS" = true ]; then
        log "WARN" "Auto-Updates run completed in ${DURATION}s with package notices/warnings. (Exit code: $STATUS)"
    else
        log "SUCCESS" "Auto-Updates run completed successfully in ${DURATION}s. (Exit code: $STATUS)"
    fi
else
    log "ERROR" "Auto-Updates run failed with exit code $STATUS after ${DURATION}s."
    exit "$STATUS"
fi

PKG_STATE_AFTER=""
PACKAGES_MODIFIED=false
if command -v rpm &>/dev/null; then
    PKG_STATE_AFTER=$(rpm -qa --last 2>/dev/null | head -n 1 || true)
elif [ -f /var/log/dpkg.log ]; then
    PKG_STATE_AFTER=$(tail -n 1 /var/log/dpkg.log 2>/dev/null || true)
fi

if [ -n "$PKG_STATE_BEFORE" ] && [ -n "$PKG_STATE_AFTER" ] && [ "$PKG_STATE_BEFORE" != "$PKG_STATE_AFTER" ]; then
    PACKAGES_MODIFIED=true
    log "INFO" "Package transaction completed: system packages were updated."
else
    log "INFO" "Package transaction completed: no package changes detected on system."
fi

# Check for active build/compilation processes
check_active_builds() {
    local build_procs=(
        rpmbuild
        mock
        make
        ninja
        cmake
        meson
        gcc
        g++
        clang
        clang++
        rustc
        cargo
        mvn
        gradle
        pytest
        ctest
    )
    local found=()
    for proc in "${build_procs[@]}"; do
        if pgrep -x "$proc" &>/dev/null; then
            found+=("$proc")
        fi
    done

    # Check for container builds (podman build / docker build)
    if pgrep -f "(podman|docker)[ -].*build" &>/dev/null; then
        found+=("container-build")
    fi

    if [ ${#found[@]} -gt 0 ]; then
        echo "${found[*]}"
        return 0
    fi
    return 1
}

# Check for systemd shutdown inhibitor locks
check_shutdown_inhibitors() {
    if command -v systemd-inhibit &>/dev/null; then
        local blocker
        blocker=$(systemd-inhibit --list --no-pager 2>/dev/null | awk '$6 ~ /shutdown/ && $8 == "block" {print $1}' | head -n 1)
        if [ -n "$blocker" ]; then
            echo "$blocker"
            return 0
        fi
    fi
    return 1
}

# Check reboot policy if updates were applied
if [ "$DRY_RUN" = false ]; then
    REBOOT_NEEDED=false
    if [ "$REBOOT" = "when-needed" ]; then
        if [ "$BACKEND" = "apt" ]; then
            if [ -f /run/reboot-required ] || [ -f /var/run/reboot-required ]; then
                REBOOT_NEEDED=true
            fi
        elif command -v dnf5 &>/dev/null && dnf5 needs-restarting --help &>/dev/null; then
            local dnf5_rc=0
            dnf5 --disablerepo='*' needs-restarting -r &>/dev/null || dnf5_rc=$?
            if [ "$dnf5_rc" -eq 1 ]; then
                REBOOT_NEEDED=true
            fi
        elif command -v needs-restarting &>/dev/null; then
            local nr_rc=0
            needs-restarting -r &>/dev/null || nr_rc=$?
            if [ "$nr_rc" -eq 1 ]; then
                REBOOT_NEEDED=true
            fi
        elif [ -f /run/reboot-required ] || [ -f /var/run/reboot-required ]; then
            REBOOT_NEEDED=true
        else
            log "WARN" "Reboot policy is 'when-needed' but 'needs-restarting' was not found. Please install yum-utils."
        fi
    elif [ "$REBOOT" = "when-changed" ]; then
        if [ "$PACKAGES_MODIFIED" = true ]; then
            REBOOT_NEEDED=true
        else
            log "INFO" "Reboot policy is 'when-changed' but no packages were modified; reboot not required."
            REBOOT_NEEDED=false
        fi
    fi

    if [ "$REBOOT_NEEDED" = true ]; then
        # Safety Floor 1: Never trigger automated reboot if system uptime is under 15 minutes (900 seconds)
        UPTIME_SEC=$(awk '{print int($1)}' /proc/uptime 2>/dev/null || echo 0)
        if [ "$UPTIME_SEC" -lt 900 ]; then
            log "WARN" "Automated reboot skipped: System uptime is only ${UPTIME_SEC}s (safety floor: 900s). Preventing boot-time reboot loop."
            exit 0
        fi

        # Safety Floor 2: Rate-limit automated reboots (cooldown period of 1 hour / 3600 seconds)
        REBOOT_STAMP="/var/run/auto-updates-reboot.stamp"
        if [ -f "$REBOOT_STAMP" ]; then
            LAST_REBOOT_TIME=$(stat -c %Y "$REBOOT_STAMP" 2>/dev/null || echo 0)
            NOW_TIME=$(date +%s)
            ELAPSED=$(( NOW_TIME - LAST_REBOOT_TIME ))
            if [ "$ELAPSED" -lt 3600 ]; then
                log "WARN" "Automated reboot skipped: System was rebooted $ELAPSED seconds ago (cooldown: 3600s)."
                exit 0
            fi
        fi

        if [ "$DEFER_REBOOT_IF_BUSY" = "true" ]; then
            active_builds=""
            if active_builds=$(check_active_builds); then
                log "WARN" "Automated reboot postponed: Active build process(es) detected ($active_builds)."
                log "WARN" "Reboot deferred to next scheduled maintenance window."
                exit 0
            fi

            inhibitor_app=""
            if inhibitor_app=$(check_shutdown_inhibitors); then
                log "WARN" "Automated reboot postponed: System shutdown inhibitor lock held by '$inhibitor_app'."
                log "WARN" "Reboot deferred to next scheduled maintenance window."
                exit 0
            fi
        fi

        # Record reboot timestamp before rebooting
        mkdir -p "$(dirname "$REBOOT_STAMP")" 2>/dev/null || true
        touch "$REBOOT_STAMP" 2>/dev/null || true

        if [ "${REBOOT_DELAY:-0}" -gt 0 ] 2>/dev/null; then
            log "WARN" "System reboot required according to policy ($REBOOT). Scheduling reboot in ${REBOOT_DELAY} minute(s)..."
            shutdown -r "+${REBOOT_DELAY}" "System rebooting in ${REBOOT_DELAY} minutes to complete package updates. Run 'sudo shutdown -c' to cancel." 2>&1 | emit_log || true
        else
            log "WARN" "System reboot required according to policy ($REBOOT). Initiating immediate reboot via systemctl reboot..."
            systemctl reboot 2>&1 | emit_log || shutdown -r now 2>&1 | emit_log || true
        fi
    fi
fi

exit 0
