#!/bin/bash
# ==============================================================================
# auto-updates
# CLI management utility for automated package updates.
# Supports Fedora, Rocky Linux, AlmaLinux, RHEL, CentOS Stream, Debian, and Ubuntu.
#
# Copyright (C) 2026 Steve Rock <steve.rock@wheelhouser.com>
#
# This program is free software: you can redistribute it and/or modify
# it under the terms of the GNU General Public License as published by
# the Free Software Foundation, either version 3 of the License, or
# (at your option) any later version.
# ==============================================================================

set -euo pipefail

VERSION="1.3.3"
CONF_FILE="/etc/auto-updates/auto-updates.conf"
DNF_AUTO_CONF="/etc/dnf/automatic.conf"
RUNNER_BIN="/usr/libexec/auto-updates-runner"
TIMER_UNIT="auto-updates.timer"
SERVICE_UNIT="auto-updates.service"
LOG_FILE="/var/log/auto-updates/auto-updates.log"
DROPIN_DIR="/etc/systemd/system/${TIMER_UNIT}.d"
DROPIN_FILE="${DROPIN_DIR}/schedule.conf"

# Text styles and colors
if [ -t 1 ]; then
    BOLD="\033[1m"
    RESET="\033[0m"
    GREEN="\033[32m"
    YELLOW="\033[33m"
    BLUE="\033[34m"
    CYAN="\033[36m"
    RED="\033[31m"
else
    BOLD=""
    RESET=""
    GREEN=""
    YELLOW=""
    BLUE=""
    CYAN=""
    RED=""
fi

# Load existing configuration or defaults
load_config() {
    MODE="security"
    SCHEDULE_TIME="03:30"
    WEEKLY_DAY="Sun"
    RANDOM_SLEEP="10"
    REBOOT="never"
    REBOOT_DELAY="0"
    EMIT_VIA="stdio"
    LOG_FILE="/var/log/auto-updates/auto-updates.log"
    REFRESH_METADATA="true"
    DEFER_REBOOT_IF_BUSY="true"

    if [ -f "$CONF_FILE" ]; then
        # shellcheck source=/dev/null
        source "$CONF_FILE"
    fi
}

require_root() {
    if [ "$EUID" -ne 0 ]; then
        if command -v sudo &>/dev/null; then
            exec sudo "$0" "$@"
        else
            echo -e "${RED}[ERROR] This operation requires root privileges.${RESET}" >&2
            exit 1
        fi
    fi
}

# Run a privileged action safely from within the TUI without terminating the interactive shell
run_action() {
    local action="$1"; shift
    if [ "$EUID" -eq 0 ]; then
        case "$action" in
            set-mode) cmd_set_mode "$@" ;;
            set-reboot) cmd_set_reboot "$@" ;;
            set-reboot-delay) cmd_set_reboot_delay "$@" ;;
            set-time) cmd_set_time "$@" ;;
            set-day) cmd_set_day "$@" ;;
            set-build-protection|set-defer-reboot) cmd_set_defer_reboot "$@" ;;
            set-phased-updates) cmd_set_phased_updates "$@" ;;
            enable) cmd_enable "$@" ;;
            disable) cmd_disable "$@" ;;
            run) cmd_run "$@" ;;
            logs) cmd_logs "$@" ;;
            *) echo "Unknown action: $action" ;;
        esac
    elif command -v sudo &>/dev/null; then
        sudo "$0" "$action" "$@"
    else
        echo -e "${RED}[ERROR] This operation requires root privileges.${RESET}" >&2
    fi
}

# Helper to update key in config file
set_conf_key() {
    local key="$1"
    local val="$2"
    mkdir -p "$(dirname "$CONF_FILE")"
    if [ ! -f "$CONF_FILE" ]; then
        echo "${key}=${val}" > "$CONF_FILE"
    elif grep -q -E "^[#[:space:]]*${key}=" "$CONF_FILE"; then
        sed -i -E "s|^[#[:space:]]*${key}=.*|${key}=${val}|" "$CONF_FILE"
    else
        echo "${key}=${val}" >> "$CONF_FILE"
    fi
}

# Helper to update key in INI file
set_ini_key() {
    local file="$1"
    local section="$2"
    local key="$3"
    local val="$4"

    if [ ! -f "$file" ]; then
        mkdir -p "$(dirname "$file")"
        cat <<EOF > "$file"
[$section]
$key = $val
EOF
        return 0
    fi

    if grep -q -E "^[#[:space:]]*${key}[[:space:]]*=" "$file"; then
        sed -i -E "s|^[#[:space:]]*${key}[[:space:]]*=.*|${key} = ${val}|" "$file"
    else
        if grep -q -E "^\[${section}\]" "$file"; then
            sed -i -E "/^\[${section}\]/a ${key} = ${val}" "$file"
        else
            echo "" >> "$file"
            echo "[$section]" >> "$file"
            echo "${key} = ${val}" >> "$file"
        fi
    fi
}

cmd_status() {
    load_config

    local title="Auto-Updates Status v${VERSION}"
    local width=64
    local pad_left=$(( (width - ${#title}) / 2 ))
    local pad_right=$(( width - pad_left - ${#title} ))

    echo -e "${BOLD}${CYAN}================================================================${RESET}"
    printf "${BOLD}${CYAN}%*s%s%*s${RESET}\n" "$pad_left" "" "$title" "$pad_right" ""
    echo -e "${BOLD}${CYAN}================================================================${RESET}"

    # Timer status
    local timer_active="inactive (disabled)"
    local timer_color="$RED"
    if systemctl is-active --quiet "$TIMER_UNIT" 2>/dev/null; then
        timer_active="active (running)"
        timer_color="$GREEN"
    fi

    local timer_enabled="disabled"
    if systemctl is-enabled --quiet "$TIMER_UNIT" 2>/dev/null; then
        timer_enabled="enabled"
    fi

    printf "  ${BOLD}%-24s${RESET} : ${timer_color}%s${RESET} (%s)\n" "Timer Status" "$timer_active" "$timer_enabled"

    # Current mode
    local mode_desc=""
    case "$MODE" in
        security)
            mode_desc="Daily Security Updates Only"
            ;;
        all|daily-all)
            mode_desc="Daily Full Updates (All Packages Every Day)"
            ;;
        weekly-all|all-weekly)
            mode_desc="Daily Security + Weekly Full Updates (${WEEKLY_DAY})"
            ;;
        *)
            mode_desc="Custom ($MODE)"
            ;;
    esac
    printf "  ${BOLD}%-24s${RESET} : ${YELLOW}%s${RESET} (%s)\n" "Configured Mode" "$MODE" "$mode_desc"
    printf "  ${BOLD}%-24s${RESET} : %s (Local system time)\n" "Daily Schedule Time" "$SCHEDULE_TIME"

    if [ "$MODE" = "weekly-all" ] || [ "$MODE" = "all-weekly" ]; then
        local full_day_name=""
        case "$WEEKLY_DAY" in
            Sun) full_day_name="Sunday" ;;
            Mon) full_day_name="Monday" ;;
            Tue) full_day_name="Tuesday" ;;
            Wed) full_day_name="Wednesday" ;;
            Thu) full_day_name="Thursday" ;;
            Fri) full_day_name="Friday" ;;
            Sat) full_day_name="Saturday" ;;
            *)   full_day_name="$WEEKLY_DAY" ;;
        esac
        printf "  ${BOLD}%-24s${RESET} : %s (at %s)\n" "Weekly Full Update Day" "$full_day_name" "$SCHEDULE_TIME"
    fi

    # Next run details from systemd
    local next_run=""
    next_run=$(systemctl show "$TIMER_UNIT" --property=NextElapseUSecRealtime --value 2>/dev/null || true)
    if [ -n "$next_run" ] && [ "$next_run" != "n/a" ]; then
        printf "  ${BOLD}%-24s${RESET} : ${GREEN}%s${RESET}\n" "Next Scheduled Run" "$next_run"

        # Determine target for next run
        local next_dow
        next_dow=$(echo "$next_run" | awk '{print $1}')
        if { [ "$MODE" = "weekly-all" ] || [ "$MODE" = "all-weekly" ]; } && [ "$next_dow" = "$WEEKLY_DAY" ]; then
            printf "  ${BOLD}%-24s${RESET} : ${YELLOW}%s${RESET}\n" "Next Run Action" "Weekly Full System Update (all packages)"
        elif [ "$MODE" = "all" ] || [ "$MODE" = "daily-all" ]; then
            printf "  ${BOLD}%-24s${RESET} : %s\n" "Next Run Action" "Daily Full System Update (all packages)"
        else
            printf "  ${BOLD}%-24s${RESET} : %s\n" "Next Run Action" "Daily Security Updates Only"
        fi
    else
        printf "  ${BOLD}%-24s${RESET} : %s\n" "Next Scheduled Run" "None (timer not running)"
    fi

    # Backend detection
    local backend="Unknown"
    local os_type="rpm"
    if [ -f /etc/os-release ]; then
        local os_id=""
        os_id=$(grep -E '^(ID|ID_LIKE)=' /etc/os-release 2>/dev/null || true)
        case "$os_id" in
            *debian*|*ubuntu*)
                os_type="deb"
                ;;
        esac
    fi

    if [ "$os_type" = "deb" ] || command -v apt-get &>/dev/null && ! command -v dnf &>/dev/null && ! command -v dnf5 &>/dev/null; then
        backend="APT / Unattended-Upgrades (/usr/bin/apt-get)"
    elif command -v dnf5 &>/dev/null && dnf5 automatic --help &>/dev/null; then
        backend="DNF5 Plugin Automatic (/usr/bin/dnf5)"
    elif command -v dnf-automatic &>/dev/null; then
        backend="DNF4 Automatic (/usr/bin/dnf-automatic)"
    elif command -v dnf &>/dev/null; then
        backend="Standard DNF CLI (/usr/bin/dnf)"
    elif command -v apt-get &>/dev/null; then
        backend="APT / Unattended-Upgrades (/usr/bin/apt-get)"
    fi
    printf "  ${BOLD}%-24s${RESET} : %s\n" "Update Backend" "$backend"
    local refresh_status="enabled (query mirrors on every run)"
    if [ "${REFRESH_METADATA:-true}" = "false" ]; then
        refresh_status="disabled (use local cache)"
    fi
    printf "  ${BOLD}%-24s${RESET} : %s\n" "Metadata Refresh" "$refresh_status"

    if [ "$os_type" = "deb" ]; then
        local phased_status="standard (respect Ubuntu phased rollouts)"
        if [ "${INCLUDE_PHASED_UPDATES:-false}" = "true" ]; then
            phased_status="enabled (always include phased updates via APT)"
        fi
        printf "  ${BOLD}%-24s${RESET} : %s\n" "Phased Updates" "$phased_status"
    fi

    # Reboot policy and description
    local reboot_desc=""
    case "$REBOOT" in
        never)
            reboot_desc="Manual reboot only (recommended for workstations)"
            ;;
        when-needed)
            reboot_desc="Automatic reboot if kernel or core libraries require it"
            ;;
        when-changed)
            reboot_desc="Automatic reboot whenever any package is updated"
            ;;
        *)
            reboot_desc="$REBOOT"
            ;;
    esac
    printf "  ${BOLD}%-24s${RESET} : ${YELLOW}%s${RESET} (%s)\n" "Reboot Policy" "$REBOOT" "$reboot_desc"

    local delay_desc=""
    if [ "${REBOOT_DELAY:-0}" -eq 0 ] 2>/dev/null; then
        delay_desc="Immediate (systemctl reboot)"
    else
        delay_desc="${REBOOT_DELAY} minute(s) (shutdown -r +${REBOOT_DELAY})"
    fi
    printf "  ${BOLD}%-24s${RESET} : %s\n" "Reboot Delay" "$delay_desc"

    local guard_desc="active (defers reboot if builds/inhibitors detected)"
    if [ "${DEFER_REBOOT_IF_BUSY:-true}" = "false" ]; then
        guard_desc="disabled (reboot will not defer for builds)"
    fi
    printf "  ${BOLD}%-24s${RESET} : %s\n" "Build Protection" "$guard_desc"

    # Live reboot status (queries needs-restarting on RPM, or /run/reboot-required on Debian/Ubuntu)
    local reboot_status="Checking..."
    local reboot_color="$GREEN"
    if [ -f /run/reboot-required ] || [ -f /var/run/reboot-required ]; then
        local pkgs=""
        if [ -f /run/reboot-required.pkgs ]; then
            pkgs=$(head -n 5 /run/reboot-required.pkgs 2>/dev/null | tr '\n' ' ' | sed 's/ $//')
        fi
        reboot_status="REBOOT REQUIRED"
        [ -n "$pkgs" ] && reboot_status+=" (Packages: $pkgs)"
        reboot_color="$RED"
    elif [ "$os_type" = "deb" ]; then
        reboot_status="Clean (No reboot required)"
        reboot_color="$GREEN"
    elif command -v dnf5 &>/dev/null && dnf5 needs-restarting --help &>/dev/null; then
        if dnf5 --cacheonly needs-restarting -r &>/dev/null; then
            reboot_status="Clean (No reboot required)"
            reboot_color="$GREEN"
        else
            reboot_status="REBOOT REQUIRED (Kernel or core libraries updated since boot)"
            reboot_color="$RED"
        fi
    elif command -v needs-restarting &>/dev/null; then
        if needs-restarting -C -r &>/dev/null; then
            reboot_status="Clean (No reboot required)"
            reboot_color="$GREEN"
        else
            reboot_status="REBOOT REQUIRED (Kernel or core libraries updated since boot)"
            reboot_color="$RED"
        fi
    else
        reboot_status="Unknown (reboot status indicator not found)"
        reboot_color="$YELLOW"
    fi
    printf "  ${BOLD}%-24s${RESET} : ${reboot_color}%s${RESET}\n" "System Reboot Status" "$reboot_status"
    printf "  ${BOLD}%-24s${RESET} : %s\n" "Log File" "$LOG_FILE"

    # Last execution info
    local check_log="$LOG_FILE"
    if [ ! -f "$check_log" ] && [ -f "/var/log/auto-updates.log" ]; then
        check_log="/var/log/auto-updates.log"
    fi
    if [ -f "$check_log" ] && [ -s "$check_log" ]; then
        local last_log
        last_log=$(tail -n 1 "$check_log" 2>/dev/null || true)
        if [ -n "$last_log" ]; then
            printf "  ${BOLD}%-24s${RESET} : %s\n" "Last Log Entry" "$last_log"
        elif [ ! -r "$check_log" ]; then
            printf "  ${BOLD}%-24s${RESET} : %s\n" "Last Log Entry" "(Run with sudo to inspect privileged log file)"
        fi

        local last_notice
        last_notice=$(grep -E '\[WARN\]|\[ERROR\]' "$check_log" 2>/dev/null | tail -n 1 || true)
        if [ -n "$last_notice" ]; then
            printf "  ${BOLD}%-24s${RESET} : ${YELLOW}%s${RESET}\n" "Recent Notice" "$last_notice"
        fi
    fi

    echo -e "${BOLD}${CYAN}----------------------------------------------------------------${RESET}"
    echo -e "  ${BOLD}Quick CLI Reference & Prompts:${RESET}"
    echo -e "    ${GREEN}auto-updates -h${RESET}              View full options and command help"
    echo -e "    ${GREEN}auto-updates run${RESET}             Trigger immediate update check & install"
    echo -e "    ${GREEN}sudo auto-updates set-mode${RESET}   security | all | weekly-all"
    echo -e "    ${GREEN}sudo auto-updates set-reboot${RESET} never | when-needed | when-changed"
    echo -e "    ${GREEN}sudo auto-updates set-reboot-delay${RESET} Delay in mins (0 = immediate reboot via systemctl reboot)"
    echo -e "    ${GREEN}sudo auto-updates set-time${RESET}   Change daily update time (e.g. 03:30)"
    echo -e "    ${GREEN}sudo auto-updates set-day${RESET}    Change weekly update day (e.g. Sun)"
    echo -e "    ${GREEN}man auto-updates${RESET}             Read system manual page"
    echo -e "${BOLD}${CYAN}================================================================${RESET}"
    if [ "${1:-}" = "--wait" ] || [ "${1:-}" = "-w" ]; then
        cmd_tui
        return 0
    fi
}

cmd_set_mode() {
    local target_mode="${1:-}"
    if [ -z "$target_mode" ]; then
        echo -e "${RED}[ERROR] Missing mode argument. Usage: auto-updates mode [security|all|weekly-all]${RESET}" >&2
        exit 1
    fi

    case "$target_mode" in
        security|sec)
            require_root "set-mode" "security"
            set_conf_key "MODE" "security"
            set_ini_key "$DNF_AUTO_CONF" "commands" "upgrade_type" "security"
            echo -e "${GREEN}${BOLD}[SUCCESS] Mode updated to: security${RESET}"
            echo -e "  - Daily security updates will run at ${BOLD}${SCHEDULE_TIME:-03:30}${RESET} local time."
            echo -e "  - Non-security updates are ${BOLD}disabled${RESET}."
            ;;
        all|daily-all)
            require_root "set-mode" "all"
            set_conf_key "MODE" "all"
            set_ini_key "$DNF_AUTO_CONF" "commands" "upgrade_type" "default"
            echo -e "${GREEN}${BOLD}[SUCCESS] Mode updated to: all (daily full updates)${RESET}"
            echo -e "  - All package updates will run every single day at ${BOLD}${SCHEDULE_TIME:-03:30}${RESET} local time."
            ;;
        weekly-all|all-weekly)
            require_root "set-mode" "weekly-all"
            set_conf_key "MODE" "weekly-all"
            echo -e "${GREEN}${BOLD}[SUCCESS] Mode updated to: weekly-all (hybrid schedule)${RESET}"
            echo -e "  - Daily security updates will run Mon-Sat at ${BOLD}${SCHEDULE_TIME:-03:30}${RESET} local time."
            echo -e "  - Full updates (all packages) will run every ${BOLD}${WEEKLY_DAY:-Sun}${RESET} at ${BOLD}${SCHEDULE_TIME:-03:30}${RESET} local time."
            ;;
        *)
            echo -e "${RED}[ERROR] Invalid mode: '$target_mode'. Valid options: security, all, weekly-all.${RESET}" >&2
            exit 1
            ;;
    esac
}

cmd_enable() {
    require_root "enable"
    systemctl daemon-reload
    systemctl enable --now "$TIMER_UNIT"
    echo -e "${GREEN}${BOLD}[SUCCESS] Auto-Updates timer enabled and started.${RESET}"
    cmd_status
}

cmd_disable() {
    require_root "disable"
    systemctl disable --now "$TIMER_UNIT"
    echo -e "${YELLOW}${BOLD}[SUCCESS] Auto-Updates timer stopped and disabled.${RESET}"
}

resolve_runner() {
    local repo_runner="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/libexec/auto-updates-runner"
    if [ -x "$repo_runner" ] && [ "${BASH_SOURCE[0]}" != "/usr/bin/auto-updates" ]; then
        echo "$repo_runner"
    elif [ -x "$RUNNER_BIN" ]; then
        echo "$RUNNER_BIN"
    elif [ -x "$repo_runner" ]; then
        echo "$repo_runner"
    else
        echo ""
    fi
}

cmd_run() {
    require_root "run" "$@"
    local runner_args=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --security)
                runner_args+=(--force-security)
                shift
                ;;
            --all)
                runner_args+=(--force-all)
                shift
                ;;
            --no-sleep)
                runner_args+=(--no-sleep)
                shift
                ;;
            *)
                shift
                ;;
        esac
    done

    echo -e "${BLUE}${BOLD}[INFO] Executing manual Auto-Updates run...${RESET}"
    local runner
    runner=$(resolve_runner)
    if [ -n "$runner" ]; then
        "$runner" "${runner_args[@]}"
    else
        echo -e "${RED}[ERROR] Runner executable not found.${RESET}" >&2
        exit 1
    fi
}

cmd_check() {
    echo -e "${BLUE}${BOLD}[INFO] Checking for available updates (dry run)...${RESET}"
    local runner
    runner=$(resolve_runner)
    if [ -n "$runner" ]; then
        "$runner" --dry-run
    else
        if command -v apt-get &>/dev/null && ! command -v dnf &>/dev/null && ! command -v dnf5 &>/dev/null; then
            apt-get -s dist-upgrade || true
        elif command -v dnf5 &>/dev/null; then
            dnf5 --refresh check-upgrade --security || true
        else
            dnf --refresh check-upgrade --security || true
        fi
    fi
}

cmd_set_time() {
    local new_time="${1:-}"
    if [[ ! "$new_time" =~ ^([01][0-9]|2[0-3]):[0-5][0-9]$ ]]; then
        echo -e "${RED}[ERROR] Invalid time format '$new_time'. Expected HH:MM (24-hour, e.g. 03:30 or 21:00).${RESET}" >&2
        exit 1
    fi

    require_root "set-time" "$new_time"
    set_conf_key "SCHEDULE_TIME" "$new_time"

    # Create/update systemd drop-in override
    mkdir -p "$DROPIN_DIR"
    cat <<EOF > "$DROPIN_FILE"
[Timer]
OnCalendar=
OnCalendar=*-*-* ${new_time}:00
EOF

    systemctl daemon-reload
    if systemctl is-active --quiet "$TIMER_UNIT"; then
        systemctl restart "$TIMER_UNIT"
    fi

    echo -e "${GREEN}${BOLD}[SUCCESS] Schedule time updated to ${new_time} (local time).${RESET}"
    cmd_status
}

cmd_set_day() {
    local new_day="${1:-}"
    case "$new_day" in
        Sun|Sunday)       new_day="Sun" ;;
        Mon|Monday)      new_day="Mon" ;;
        Tue|Tuesday)     new_day="Tue" ;;
        Wed|Wednesday)   new_day="Wed" ;;
        Thu|Thursday)    new_day="Thu" ;;
        Fri|Friday)      new_day="Fri" ;;
        Sat|Saturday)    new_day="Sat" ;;
        *)
            echo -e "${RED}[ERROR] Invalid day '$new_day'. Valid options: Sun, Mon, Tue, Wed, Thu, Fri, Sat.${RESET}" >&2
            exit 1
            ;;
    esac

    require_root "set-day" "$new_day"
    set_conf_key "WEEKLY_DAY" "$new_day"

    echo -e "${GREEN}${BOLD}[SUCCESS] Weekly full update day updated to: ${new_day}.${RESET}"
    load_config
    if [ "$MODE" != "weekly-all" ] && [ "$MODE" != "all-weekly" ]; then
        echo -e "${YELLOW}[NOTE] Current mode is '$MODE'. The weekly day will take effect when mode is set to 'weekly-all'.${RESET}"
    fi
}

cmd_set_reboot() {
    local new_policy="${1:-}"
    case "$new_policy" in
        never|when-needed|when-changed)
            ;;
        *)
            echo -e "${RED}[ERROR] Invalid reboot policy '${new_policy}'.${RESET}" >&2
            echo "Valid options:" >&2
            echo "  never        : Never reboot automatically (recommended for developer workstations)" >&2
            echo "  when-needed  : Reboot only if kernel or core system libraries were updated" >&2
            echo "  when-changed : Reboot whenever any package is updated (appliance/kiosk mode)" >&2
            exit 1
            ;;
    esac

    require_root "set-reboot" "$new_policy"
    set_conf_key "REBOOT" "$new_policy"

    echo -e "${GREEN}${BOLD}[SUCCESS] Reboot policy set to: ${new_policy}${RESET}"

    if [ "$new_policy" = "when-needed" ] || [ "$new_policy" = "when-changed" ]; then
        echo ""
        echo -e "${YELLOW}${BOLD}================================================================${RESET}"
        echo -e "${YELLOW}${BOLD}                     IMPORTANT ADVISORY                         ${RESET}"
        echo -e "${YELLOW}${BOLD}================================================================${RESET}"
        echo -e "  Automated system reboots are now ${BOLD}ENABLED${RESET} (${new_policy})."
        if [ "${REBOOT_DELAY:-0}" -eq 0 ] 2>/dev/null; then
            echo -e "  Reboot delay is configured to ${BOLD}0 minutes (immediate systemctl reboot)${RESET}."
        else
            echo -e "  Reboot delay is configured to ${BOLD}${REBOOT_DELAY} minute(s)${RESET} (with delayed wall notice)."
        fi
        echo ""
        echo -e "  ${BOLD}Best Practices & Hypervisor / VM Notice:${RESET}"
        echo -e "  • ${CYAN}Virtual Machines (GNOME Boxes / KVM)${RESET}: Ensure 'Run in background' is"
        echo -e "    enabled in VM preferences, and host power-saving/sleep is disabled during"
        echo -e "    the scheduled window. Use delay 0 (immediate) to prevent session timeouts."
        echo -e "  • ${CYAN}Workstations/Laptops${RESET}: If you leave open IDEs, tabs, or"
        echo -e "    unsaved work overnight, consider keeping policy as 'never'."
        echo -e "  • ${CYAN}Overnight Builds${RESET}: Auto-Updates includes build process protection"
        echo -e "    (rpmbuild, make, ninja, cargo), but if running custom jobs you can"
        echo -e "    temporarily disable reboots with: ${BOLD}sudo auto-updates set-reboot never${RESET}"
        echo -e "  • ${CYAN}Configure Delay${RESET}: Change delay with: ${BOLD}sudo auto-updates set-reboot-delay <0|mins>${RESET}"
        echo -e "  • ${CYAN}Cancel Pending Reboot${RESET}: If a delayed reboot is scheduled, run: ${BOLD}sudo shutdown -c${RESET}"
        echo -e "${YELLOW}${BOLD}================================================================${RESET}"
    else
        echo -e "${CYAN}Automatic reboots are disabled. All reboots must be performed manually.${RESET}"
    fi

    echo ""
    cmd_status
}

cmd_set_reboot_delay() {
    local new_delay="${1:-}"
    if [ -z "$new_delay" ] || ! [[ "$new_delay" =~ ^[0-9]+$ ]]; then
        echo -e "${RED}[ERROR] Invalid reboot delay. Please specify an integer >= 0 (in minutes).${RESET}" >&2
        echo "  0 = Immediate reboot via systemctl reboot (recommended for VMs/servers)" >&2
        echo "  N = Schedule reboot in N minutes via shutdown -r +N" >&2
        exit 1
    fi

    require_root "set-reboot-delay" "$new_delay"
    set_conf_key "REBOOT_DELAY" "$new_delay"

    if [ "$new_delay" -eq 0 ]; then
        echo -e "${GREEN}${BOLD}[SUCCESS] Reboot delay set to 0 (immediate systemctl reboot).${RESET}"
    else
        echo -e "${GREEN}${BOLD}[SUCCESS] Reboot delay set to ${new_delay} minute(s).${RESET}"
    fi

    load_config
    if [ "$REBOOT" = "never" ]; then
        echo -e "${YELLOW}[NOTE] Current reboot policy is 'never'. The delay will take effect when reboot policy is 'when-needed' or 'when-changed'.${RESET}"
    fi
}

cmd_set_defer_reboot() {
    local val="${1:-}"
    if [ -z "$val" ]; then
        echo -e "${RED}[ERROR] Missing argument. Usage: auto-updates set-build-protection [true|false]${RESET}" >&2
        exit 1
    fi
    case "$val" in
        true|on|enable|enabled|1)
            val="true"
            ;;
        false|off|disable|disabled|0)
            val="false"
            ;;
        *)
            echo -e "${RED}[ERROR] Invalid option '$val'. Valid values: true, false.${RESET}" >&2
            exit 1
            ;;
    esac

    require_root "set-build-protection" "$val"
    set_conf_key "DEFER_REBOOT_IF_BUSY" "$val"

    echo -e "${GREEN}${BOLD}[SUCCESS] Build protection deferral set to: ${val}${RESET}"
    if [ "$val" = "true" ]; then
        echo -e "  Reboots will be deferred if compiler or build processes (rpmbuild, cargo, make) are active."
    else
        echo -e "  Reboots will proceed immediately regardless of background build processes."
    fi
}

cmd_set_phased_updates() {
    local val="${1:-}"
    if [ -z "$val" ]; then
        echo -e "${RED}[ERROR] Missing argument. Usage: auto-updates set-phased-updates [true|false]${RESET}" >&2
        exit 1
    fi
    case "$val" in
        true|on|enable|enabled|1|yes)
            val="true"
            ;;
        false|off|disable|disabled|0|no)
            val="false"
            ;;
        *)
            echo -e "${RED}[ERROR] Invalid option '$val'. Expected 'true' or 'false'.${RESET}" >&2
            exit 1
            ;;
    esac

    require_root "set-phased-updates" "$val"
    set_conf_key "INCLUDE_PHASED_UPDATES" "$val"

    echo -e "${GREEN}${BOLD}[SUCCESS] Phased updates policy set to: ${val}${RESET}"
    if [ "$val" = "true" ]; then
        echo -e "  APT will include phased package rollouts immediately (-o APT::Get::Always-Include-Phased-Updates=true)."
    else
        echo -e "  APT will respect Ubuntu standard gradual phased rollout schedules."
    fi
}

cmd_logs() {
    load_config
    local count="${1:-40}"
    local check_log="$LOG_FILE"
    if [ ! -f "$check_log" ] && [ -f "/var/log/auto-updates.log" ]; then
        check_log="/var/log/auto-updates.log"
    fi
    if [ -f "$check_log" ] && [ -s "$check_log" ]; then
        if [ -r "$check_log" ]; then
            echo -e "${BOLD}${CYAN}--- Auto-Updates Log: $check_log (Last $count lines) ---${RESET}"
            tail -n "$count" "$check_log"
        else
            require_root "logs" "$count"
        fi
    else
        echo -e "${BOLD}${CYAN}--- Systemd Journal: $SERVICE_UNIT ---${RESET}"
        journalctl -u "$SERVICE_UNIT" -n "$count" --no-pager || true
    fi
}

cmd_tui() {
    export IS_TUI=true
    clear || true
    cmd_status
    echo ""
    echo -e "${BOLD}${CYAN}----------------------------------------------------------------${RESET}"
    read -r -p "  Press [c] to configure, or Enter to close: " init_choice || return 0
    if [[ ! "$init_choice" =~ ^[cC]$ ]]; then
        return 0
    fi

    while true; do
        clear || true
        cmd_status
        echo ""
        echo -e "${BOLD}${CYAN}----------------------------------------------------------------${RESET}"
        echo -e "${BOLD}${YELLOW}  Interactive Configuration & Actions Menu:${RESET}"
        echo -e "    ${GREEN}[1]${RESET} Set Update Mode         (security / all / weekly-all)"
        echo -e "    ${GREEN}[2]${RESET} Set Reboot Policy       (never / when-needed / when-changed)"
        echo -e "    ${GREEN}[3]${RESET} Set Reboot Delay        (0 = immediate, or custom minutes)"
        echo -e "    ${GREEN}[4]${RESET} Set Daily Update Time   (24h format, e.g. 03:30)"
        echo -e "    ${GREEN}[5]${RESET} Set Weekly Update Day   (Sun, Mon, Tue, Wed, Thu, Fri, Sat)"
        echo -e "    ${GREEN}[6]${RESET} Toggle Build Protection (defer reboot if compilation is active)"
        echo -e "    ${GREEN}[7]${RESET} Run Updates Now         (immediate check and install)"
        echo -e "    ${GREEN}[8]${RESET} Check Available Updates (dry-run inspection)"
        echo -e "    ${GREEN}[9]${RESET} Toggle Timer State      (enable or disable systemd timer)"
        echo -e "    ${GREEN}[0]${RESET} View Execution Logs     (recent log entries)"
        echo -e "    ${GREEN}[R]${RESET} Refresh Status Dashboard"
        echo -e "    ${GREEN}[Q]${RESET} Quit / Close"
        echo -e "${BOLD}${CYAN}----------------------------------------------------------------${RESET}"
        read -r -p "  Select an option [0-9, R, Q]: " choice || break

        case "$choice" in
            1)
                echo ""
                echo -e "${BOLD}Select Update Mode:${RESET}"
                echo "  [1] security   - Daily security updates only (recommended for servers)"
                echo "  [2] all        - Daily full updates (all packages every day)"
                echo "  [3] weekly-all - Daily security + weekly full system upgrades (recommended for workstations)"
                echo "  [C] Cancel"
                read -r -p "Enter choice [1-3, C]: " m_choice
                case "$m_choice" in
                    1) run_action "set-mode" "security" ;;
                    2) run_action "set-mode" "all" ;;
                    3) run_action "set-mode" "weekly-all" ;;
                    *) echo "Cancelled." ;;
                esac
                echo ""
                read -n 1 -s -r -p "Press any key to continue..."
                ;;
            2)
                echo ""
                echo -e "${BOLD}Select Reboot Policy:${RESET}"
                echo "  [1] never        - Never reboot automatically (recommended for workstations)"
                echo "  [2] when-needed  - Reboot only if kernel or core libraries were updated"
                echo "  [3] when-changed - Reboot whenever any package is updated (appliance/kiosk mode)"
                echo "  [C] Cancel"
                read -r -p "Enter choice [1-3, C]: " r_choice
                case "$r_choice" in
                    1) run_action "set-reboot" "never" ;;
                    2) run_action "set-reboot" "when-needed" ;;
                    3) run_action "set-reboot" "when-changed" ;;
                    *) echo "Cancelled." ;;
                esac
                echo ""
                read -n 1 -s -r -p "Press any key to continue..."
                ;;
            3)
                echo ""
                read -r -p "Enter reboot delay in minutes (0 for immediate systemctl reboot): " d_choice
                if [ -n "$d_choice" ]; then
                    run_action "set-reboot-delay" "$d_choice"
                fi
                echo ""
                read -n 1 -s -r -p "Press any key to continue..."
                ;;
            4)
                echo ""
                read -r -p "Enter daily execution time (HH:MM in 24-hour local time, e.g. 03:30): " t_choice
                if [ -n "$t_choice" ]; then
                    run_action "set-time" "$t_choice"
                fi
                echo ""
                read -n 1 -s -r -p "Press any key to continue..."
                ;;
            5)
                echo ""
                echo -e "${BOLD}Select Weekly Full Update Day:${RESET}"
                echo "  [1] Sunday     [2] Monday     [3] Tuesday    [4] Wednesday"
                echo "  [5] Thursday   [6] Friday     [7] Saturday   [C] Cancel"
                read -r -p "Enter choice [1-7, C]: " w_choice
                case "$w_choice" in
                    1) run_action "set-day" "Sun" ;;
                    2) run_action "set-day" "Mon" ;;
                    3) run_action "set-day" "Tue" ;;
                    4) run_action "set-day" "Wed" ;;
                    5) run_action "set-day" "Thu" ;;
                    6) run_action "set-day" "Fri" ;;
                    7) run_action "set-day" "Sat" ;;
                    *) echo "Cancelled." ;;
                esac
                echo ""
                read -n 1 -s -r -p "Press any key to continue..."
                ;;
            6)
                echo ""
                load_config
                local cur_protect="${DEFER_REBOOT_IF_BUSY:-true}"
                if [ "$cur_protect" = "true" ]; then
                    read -r -p "Build protection is active. Disable it? [y/N]: " tog
                    if [[ "$tog" =~ ^[Yy]$ ]]; then
                        run_action "set-build-protection" "false"
                    fi
                else
                    read -r -p "Build protection is disabled. Enable it? [y/N]: " tog
                    if [[ "$tog" =~ ^[Yy]$ ]]; then
                        run_action "set-build-protection" "true"
                    fi
                fi
                echo ""
                read -n 1 -s -r -p "Press any key to continue..."
                ;;
            7)
                echo ""
                read -r -p "Trigger update run now? [y/N]: " run_confirm
                if [[ "$run_confirm" =~ ^[Yy]$ ]]; then
                    run_action "run"
                else
                    echo "Cancelled."
                fi
                echo ""
                read -n 1 -s -r -p "Press any key to continue..."
                ;;
            8)
                echo ""
                echo -e "${CYAN}Checking available package updates (dry run)...${RESET}"
                cmd_check
                echo ""
                read -n 1 -s -r -p "Press any key to continue..."
                ;;
            9)
                echo ""
                if systemctl is-active --quiet "$TIMER_UNIT" 2>/dev/null; then
                    read -r -p "Timer is active. Disable it? [y/N]: " tog
                    if [[ "$tog" =~ ^[Yy]$ ]]; then
                        run_action "disable"
                    fi
                else
                    read -r -p "Timer is inactive. Enable it? [y/N]: " tog
                    if [[ "$tog" =~ ^[Yy]$ ]]; then
                        run_action "enable"
                    fi
                fi
                echo ""
                read -n 1 -s -r -p "Press any key to continue..."
                ;;
            0)
                echo ""
                cmd_logs 40
                echo ""
                read -n 1 -s -r -p "Press any key to continue..."
                ;;
            r|R)
                load_config
                ;;
            q|Q|exit)
                echo ""
                echo "Exiting Auto-Updates."
                break
                ;;
            *)
                echo -e "${RED}Invalid selection. Please choose an option from the menu.${RESET}"
                sleep 1
                ;;
        esac
    done
}

cmd_help() {
    load_config
    echo -e "${BOLD}auto-updates${RESET} - CLI and systemd automated updater (v${VERSION})

${BOLD}USAGE:${RESET}
  auto-updates [COMMAND|OPTION]

${BOLD}COMMANDS:${RESET}
  ${GREEN}tui${RESET}                          Launch interactive TUI configuration menu (alias: interactive, -i)
  ${GREEN}status${RESET}                       Show current configuration, timer status, and next scheduled run
  ${GREEN}set-mode <security|all|weekly-all>${RESET} Set the update mode (alias: mode):
                                 ${BOLD}security${RESET}   : Daily security updates only (default)
                                 ${BOLD}all${RESET}        : Full updates (all packages) every day
                                 ${BOLD}weekly-all${RESET} : Daily security + weekly full updates (${WEEKLY_DAY:-Sun})
  ${GREEN}enable${RESET}                       Enable and start the systemd timer
  ${GREEN}disable${RESET}                      Stop and disable the systemd timer
  ${GREEN}run [--security|--all]${RESET}       Trigger an immediate update execution
  ${GREEN}check${RESET}                        Check for available updates without installing (dry run)
  ${GREEN}set-time <HH:MM>${RESET}             Change daily update time (24h local time, e.g. 03:30)
  ${GREEN}set-day <Day>${RESET}                Change weekly full-update day (e.g. Sun, Sat)
  ${GREEN}set-reboot <never|when-needed|when-changed>${RESET} Set automated reboot policy (alias: --reboot):
                                 ${BOLD}never${RESET}        : Never reboot automatically (default/recommended for workstations)
                                 ${BOLD}when-needed${RESET}  : Reboot only if kernel or core libraries were updated
                                 ${BOLD}when-changed${RESET} : Reboot whenever any package is updated (appliance/kiosk mode)
  ${GREEN}set-reboot-delay <minutes>${RESET}   Set delay before reboot in minutes (0 = immediate via systemctl reboot)
  ${GREEN}set-build-protection <true|false>${RESET} Toggle automated build & compiler process reboot protection
  ${GREEN}set-phased-updates <true|false>${RESET} Configure whether Ubuntu phased updates are included immediately
  ${GREEN}logs [N]${RESET}                     View the last N log lines (default: 40)
  ${GREEN}help${RESET}                         Show this help documentation
  ${GREEN}version${RESET}                      Show version information

${BOLD}SHORTCUT OPTIONS:${RESET}
  -s, --status                 Alias for 'status'
  -i, --tui                    Alias for 'tui'
  --security                   Alias for 'mode security'
  --all                        Alias for 'mode all'
  --weekly-all, --all-weekly   Alias for 'mode weekly-all'
  --reboot <policy>            Alias for 'set-reboot'
  -e, --enable                 Alias for 'enable'
  -d, --disable                Alias for 'disable'
  -r, --run                    Alias for 'run'
  -c, --check                  Alias for 'check'
  -l, --logs [N]               Alias for 'logs'
  -h, --help                   Alias for 'help'
  -v, --version                Alias for 'version'

${BOLD}EXAMPLES:${RESET}
  auto-updates tui
  auto-updates status
  auto-updates -h
  auto-updates run
  man auto-updates
  sudo auto-updates mode all
  sudo auto-updates set-time 04:00
  sudo auto-updates set-day Sun
  sudo auto-updates set-reboot when-needed
  sudo auto-updates set-reboot-delay 0
  sudo auto-updates set-build-protection true
  sudo auto-updates run --security
  auto-updates logs 20"
}

cmd_version() {
    echo "auto-updates version ${VERSION}"
}

# Main entry point
load_config

ACTION="${1:-status}"
shift || true

case "$ACTION" in
    status|-s|--status)
        cmd_status "$@"
        ;;
    set-mode|mode)
        cmd_set_mode "$@"
        ;;
    --security)
        cmd_set_mode "security"
        ;;
    --all)
        cmd_set_mode "all"
        ;;
    --weekly-all|--all-weekly)
        cmd_set_mode "weekly-all"
        ;;
    enable|-e|--enable)
        cmd_enable
        ;;
    disable|-d|--disable)
        cmd_disable
        ;;
    run|-r|--run)
        cmd_run "$@"
        ;;
    check|-c|--check)
        cmd_check
        ;;
    set-time|time)
        cmd_set_time "$@"
        ;;
    set-day|day)
        cmd_set_day "$@"
        ;;
    set-reboot|reboot|--reboot)
        cmd_set_reboot "$@"
        ;;
    set-reboot-delay|set-delay|delay)
        cmd_set_reboot_delay "$@"
        ;;
    set-build-protection|set-defer-reboot|defer-reboot)
        cmd_set_defer_reboot "$@"
        ;;
    set-phased-updates|phased-updates)
        cmd_set_phased_updates "$@"
        ;;
    tui|interactive|--tui|-i)
        cmd_tui
        ;;
    logs|log|-l|--logs)
        cmd_logs "$@"
        ;;
    help|-h|--help)
        cmd_help
        ;;
    version|-v|--version)
        cmd_version
        ;;
    *)
        echo -e "${RED}[ERROR] Unknown command or option: '$ACTION'${RESET}" >&2
        echo "Run 'auto-updates help' for available commands." >&2
        exit 1
        ;;
esac
