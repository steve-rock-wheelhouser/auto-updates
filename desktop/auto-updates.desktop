[Desktop Entry]
Version=1.0
Type=Application
Name=Auto-Updates
GenericName=Automated System Updates Manager
Comment=Configure and monitor automated system package updates and reboot policies
Icon=auto-updates
Exec=auto-updates status --wait
Terminal=true
Categories=System;PackageManager;
Keywords=update;upgrade;dnf;apt;security;patch;package;reboot;systemd;
StartupNotify=false
X-GNOME-UsesNotifications=true
